# Copy to .env.local (local runs) and set the same names in Vercel (deploys). Never commit real values.
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# LLM providers, tried in this order; set at least one. Optional per-provider model: GEMINI_MODEL, OPENROUTER_MODEL...
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Web search and JS-heavy pages (optional; comma-separate several keys to rotate)
FIRECRAWL_API_KEY=
# Required for /api/cron/refresh (scheduled refresh); without it the endpoint refuses every call
CRON_SECRET=
# Optional
GITHUB_TOKEN=
RUN_LIMIT_PER_HOUR=
AI_LIMIT_PER_HOUR=
